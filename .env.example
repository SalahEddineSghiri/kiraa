POSTGRES_DB=kiraa
POSTGRES_USER=kiraa
# Use a strong URL-safe password (letters, numbers, '-' and '_').
POSTGRES_PASSWORD=
# Compose constructs DATABASE_URL for app automatically; db is Docker's hostname.
# For tools outside Docker, supply a separate reachable database URL if needed.
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=30
# RAG uses local lexical-hash-v1 vectors (1536D); no remote embedding key.
EMBEDDING_MODEL=lexical-hash-v1
NEXT_PUBLIC_MAX_UPLOAD_MB=10
# Nginx limits the entire multipart request (all files combined) to 10 MiB.
ADMIN_API_KEY=
TLS_ENABLED=false
# For production mount a host directory containing fullchain.pem and privkey.pem.
TLS_CERTS_DIR=./certs
TLS_CERT_FILE=/etc/nginx/certs/fullchain.pem
TLS_KEY_FILE=/etc/nginx/certs/privkey.pem

# Private diagnostic port; public TLS belongs to the existing VPS proxy.
NGINX_BIND_IP=127.0.0.1
NGINX_HTTP_PORT=8080
